{
  "manifest_version": 3,
  "name": "Assistant Gmail IA",
  "version": "1.0",
  "description": "Génère ou répond à des e-mails avec Gemini directement dans Gmail.",
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js","config.js"],
      "css": ["styles.css"]
    }
  ]
}